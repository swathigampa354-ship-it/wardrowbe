# Nothing below this line belongs in a trial image. Every entry here is a
# multi-hundred-MB layer or a file that would leak local state into the build.
.git
.gitignore
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
frontend/node_modules
**/node_modules
frontend/.next
frontend/tsconfig.tsbuildinfo
frontend/Dockerfile.dev
frontend/.env*
backend/.env*
backend/venv
**/.venv
**/storage
**/data
storage
data
*.log
.DS_Store
docs
screenshots
