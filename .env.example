# ============================================================================
# Wardrowbe trial - environment. Copy to .env (docker compose) or paste into
# Render's "Environment Variables" tab. Nothing secret belongs in the image or
# in the frontend bundle: only these server-side names are read.
# ============================================================================

# --- AI provider (REQUIRED for analysis; OpenAI-compatible chat endpoint) -----
# The trial talks to any OpenAI-compatible /chat/completions API. The default
# below is Google's Gemini free tier through its OpenAI-compatible endpoint,
# because that is the only provider with a genuinely free vision model today -
# swap in OpenAI/OpenRouter/Groq/Ollama by changing these three values.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_API_KEY=
AI_VISION_MODEL=gemini-2.5-flash
AI_TEXT_MODEL=gemini-2.5-flash

# Per-call budget. A 4000-token response cut off mid-JSON is reported as
# "the model's reply was cut off", not as a silent failure, so raise this
# before raising the timeout.
AI_TIMEOUT=90
AI_MAX_RETRIES=2
AI_MAX_TOKENS=4000
# Comma-separated lists rotate across calls (useful when a free tier rate-limits
# one model but not the other): AI_VISION_MODEL=gemini-2.5-flash,gemma-3-27b-it
# Some providers reject reasoning_effort / logprobs outright; the client drops
# those optional parameters on a 400 and retries instead of failing.
# AI_REASONING_EFFORT=low

# How many uploads hit the provider at once. Kept low: with SQLite all writes
# are serialized anyway, and free-tier quota is the real ceiling. 1-8.
AI_UPLOAD_CONCURRENCY=3

# --- Storage -----------------------------------------------------------------
# Empty DATABASE_URL => SQLite inside STORAGE_DIR (single-file demo database).
# On Render Free you can instead attach their free Postgres, which expires after
# 30 days - see docs/free-tier-limits.md.
DATABASE_URL=
STORAGE_DIR=/data/wardrobe

# Durable object storage. Without these, photos live on the container disk and
# ARE DELETED on every redeploy, restart or spin-down - that is a Render
# limitation, not something the app can fix. Any S3-compatible bucket works
# (Cloudflare R2 free tier, Backblaze B2, MinIO...).
# STORAGE_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# STORAGE_S3_BUCKET=wardrowbe
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=auto

# Upload ceilings. Oversized/megapixel-abuse images are rejected with a readable
# 400 rather than downscaled from a 200MB file.
MAX_UPLOAD_SIZE_MB=10
MAX_BULK_UPLOAD_COUNT=20
MAX_IMAGE_MEGAPIXELS=50

# --- Auth (off by default) -----------------------------------------------------
# No user table, no sign-up, no OIDC: everyone is the same implicit demo user.
# REQUIRE_AUTH=true makes the API demand a Bearer token issued by POST /auth/sync.
REQUIRE_AUTH=false
# DEMO_PASSWORD=choose-something   # only checked by /auth/sync
SECRET_KEY=change-me-in-production
DEBUG=false

# Only needed if the UI is served from a different origin than the API.
CORS_ORIGINS=["*"]

# --- Weather (optional) --------------------------------------------------------
# Open-Meteo only: no API key, no IP geolocation lookup.
WEATHER_ENABLED=true
# Fallback used when the visitor never grants browser geolocation.
DEFAULT_LATITUDE=17.385
DEFAULT_LONGITUDE=78.4867
DEFAULT_LOCATION=Hyderabad,Telangana,IN

# --- Optional tuning (all safe to leave out) ----------------------------------
# Image renditions written next to each original: a 400px card thumbnail and an
# 800px detail view, both JPEG at this quality.
THUMBNAIL_SIZE=400
MEDIUM_SIZE=800
IMAGE_QUALITY=85
# Weather endpoint (key-free). Overridable if you self-host an alternative.
OPENMETEO_URL=https://api.open-meteo.com/v1/forecast
# DATABASE_ECHO=true logs every SQL statement - useful once, painful forever.
DATABASE_ECHO=false
APP_NAME=wardrowbe-trial

# --- Ports (the image's entrypoint wires these together) ---------------------
PORT=10000
FRONTEND_PORT=10000
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
